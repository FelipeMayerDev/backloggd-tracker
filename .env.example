# Login do Backloggd. Escolha uma opção:
# Cookie "_backloggd_session" do navegador (F12 > Application > Cookies > backloggd.com)
BACKLOGGD_SESSION=
# Ou usuário e senha (não funciona em contas criadas com Google/Discord/Steam)
# BACKLOGGD_USERNAME=
# BACKLOGGD_PASSWORD=
# Ou importar a sessão do Firefox
# BACKLOGGD_BROWSER_IMPORT=firefox

# Sessões mais curtas que isso são ignoradas (minutos)
# MIN_MINUTES=5
